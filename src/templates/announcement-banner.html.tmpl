<div class="thes__announce" id="thes-announce" data-hash="{{ANNOUNCEMENT_HASH}}">
  <div class="thes__announce-inner">
    <div class="thes__announce-track" id="thes-announce-track">
{{ANNOUNCEMENT_SLIDES}}
    </div>
    <button type="button" class="thes__announce-close" id="thes-announce-close" aria-label="Dismiss announcement">&times;</button>
  </div>
</div>
<script>
(function () {
  var banner = document.getElementById("thes-announce");
  if (!banner) return;
  var STORAGE_KEY = "thes_announce_dismissed";
  var hash = banner.getAttribute("data-hash");
  try {
    if (window.localStorage && localStorage.getItem(STORAGE_KEY) === hash) {
      banner.style.display = "none";
      return;
    }
  } catch (e) {}

  var closeBtn = document.getElementById("thes-announce-close");
  if (closeBtn) {
    closeBtn.addEventListener("click", function () {
      banner.style.display = "none";
      try {
        if (window.localStorage) localStorage.setItem(STORAGE_KEY, hash);
      } catch (e) {}
    });
  }

  var slides = banner.querySelectorAll(".thes__announce-slide");
  if (slides.length < 2) return;
  // Shuffle the rotation order on every page load, so the same first few
  // announcements don't always get seen while the later ones rarely do.
  var order = [];
  for (var k = 0; k < slides.length; k++) order.push(k);
  for (var k = order.length - 1; k > 0; k--) {
    var r = Math.floor(Math.random() * (k + 1));
    var tmp = order[k]; order[k] = order[r]; order[r] = tmp;
  }
  if (order[0] !== 0) {
    slides[0].style.display = "none";
    slides[order[0]].style.display = "flex";
    slides[order[0]].style.opacity = "1";
  }
  var i = 0;
  setInterval(function () {
    var current = slides[order[i]];
    var nextIndex = (i + 1) % order.length;
    var next = slides[order[nextIndex]];
    current.style.opacity = "0";
    setTimeout(function () {
      current.style.display = "none";
      next.style.display = "flex";
      next.style.opacity = "0";
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          next.style.opacity = "1";
        });
      });
    }, 400);
    i = nextIndex;
  }, 4800);  // 4s fully readable + 0.4s fade out + 0.4s fade in
})();
</script>
