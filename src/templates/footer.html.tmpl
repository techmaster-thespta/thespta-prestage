<section class="thes__section" style="padding-top:0;">
  <div class="thes__wrap">
    <div class="thes__footer">
      <div class="thes__footer-grid">
        <div>
          <div class="thes__footer-brand">{{org_name}}</div>
          <p>{{school_name}}<br>{{address_line1}}<br>{{address_line2}}</p>
        </div>
        <div>
          <h4>Quick Links</h4>
          <ul>
            <li><a href="{{page_urls.home}}">Home</a></li>
            <li><a href="{{page_urls.events}}">Events</a></li>
            <li><a href="{{page_urls.get_involved}}">Get Involved</a></li>
            <li><a href="{{page_urls.about}}">About</a></li>
            <li><a href="{{page_urls.newsletter}}">Newsletters</a></li>
            <li><a href="{{page_urls.shop}}">Shop</a></li>
          </ul>
        </div>
        <div>
          <h4>Connect</h4>
          <p><a href="mailto:{{email}}">{{email}}</a></p>
          <p class="thes__social-links">
            <a href="{{social.facebook_href}}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V8c0-.9.2-1.5 1.6-1.5H17V3.7C16.6 3.6 15.4 3.5 14 3.5c-2.8 0-4.7 1.7-4.7 4.9V10H6.5v3.1h2.8V21h4.2z"/></svg>
            </a>
            <a href="{{social.instagram_href}}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" stroke="none"/></svg>
            </a>
          </p>
        </div>
        <div>
          <h4>Stay in the Know</h4>
          <p>Subscribe to our newsletter for the latest updates.</p>
          <p style="margin-top:6px;"><a href="{{newsletter_href}}">Subscribe &rarr;</a></p>
        </div>
      </div>
      <div class="thes__footer-bottom">&copy; {{copyright_year}} {{org_name}}. All rights reserved.</div>
    </div>
  </div>
</section>
