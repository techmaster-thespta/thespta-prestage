<!--
  THUNDER HILL PTA — NEWSLETTER LANDING (generated by build.py — do not
  hand-edit pages/newsletter.html)
  A landing page for the two newsletters — pick one below. Each has its
  own page under src/templates/pages/newsletter/; this file just links
  to them, it has no content of its own to edit.
-->
{{TOKENS}}

<div class="thes">

  <div class="thes__pagehead">
    <div class="thes__pagehead-text">
      <span class="thes__eyebrow">Newsletters</span>
      <h1>{{PAGE_TITLE}}</h1>
      <p>Two ways to keep up with {{school_short_name}} — pick whichever fits what you're looking for.</p>
    </div>
    <div class="thes__pagehead-media">
      <img src="{{PAGE_HEADER_IMAGE_URL}}" alt="{{school_name}}">
    </div>
  </div>

  <!-- ===== Pick a newsletter ===== -->
  <section class="thes__section thes__section--tint">
    <div class="thes__wrap">
      <div class="thes__program-grid">
        <div class="thes__program-card">
          <h3>PTA Newsletter</h3>
          <p>PTA news and celebrations, published on Givebacks.</p>
          <a href="{{page_urls.pta_newsletter}}">Read It &rarr;</a>
        </div>
        <div class="thes__program-card">
          <h3>THES Official Newsletter (THES Happenings)</h3>
          <p>The school's own newsletter — everything happening at {{school_name}}, published on Smore.</p>
          <a href="{{page_urls.thes_happenings}}">Read It &rarr;</a>
        </div>
      </div>
    </div>
  </section>

{{FOOTER}}

</div>
