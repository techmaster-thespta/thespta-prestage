<!--
  THUNDER HILL PTA — PTA NEWSLETTER (generated by build.py — do not
  hand-edit pages/newsletter/pta-newsletter.html)
  This newsletter is hosted on Givebacks (the same platform behind
  membership_portal_href/donate_href/shop_href elsewhere on this site),
  fetched client-side by id — config/site.json's `pta_newsletter_id` is
  the only thing to change for a new issue; edit that, not this file.
  Get the id from Givebacks' own newsletter embed snippet next time
  there's a new one to swap in.
-->
{{TOKENS}}

<div class="thes">

  <div class="thes__pagehead">
    <div class="thes__pagehead-text">
      <span class="thes__eyebrow">Newsletter</span>
      <h1>{{PAGE_TITLE}}</h1>
      <p>PTA news and celebrations, published on Givebacks.</p>
    </div>
    <div class="thes__pagehead-media">
      <img src="{{PAGE_HEADER_IMAGE_URL}}" alt="{{school_name}}">
    </div>
  </div>

  <!-- ===== Newsletter embed (Givebacks) ===== -->
  <section class="thes__section">
    <div class="thes__wrap">
      <iframe
        id="pta-newsletter"
        title="PTA Weekly News & Celebrations"
        style="width:100%; border:0; background:#f5f6f9;"
      ></iframe>
    </div>
  </section>

{{FOOTER}}

<script>
  const newsletterId = "{{pta_newsletter_id}}";

  const apiUrl =
    `https://api.givebacks.com/services/communication/consumer/newsletters/${newsletterId}`;

  const frame = document.getElementById("pta-newsletter");

  fetch(apiUrl)
    .then(response => {
      if (!response.ok) throw new Error("Newsletter could not be loaded");
      return response.json();
    })
    .then(({ newsletter }) => {
      frame.srcdoc = newsletter.raw_html;

      frame.onload = () => {
        const documentInside = frame.contentDocument;

        const resize = () => {
          frame.style.height =
            `${documentInside.documentElement.scrollHeight}px`;
        };

        resize();
        new ResizeObserver(resize)
          .observe(documentInside.documentElement);
      };
    })
    .catch(() => {
      frame.outerHTML =
        "<p>The newsletter is temporarily unavailable.</p>";
    });
</script>

</div>
