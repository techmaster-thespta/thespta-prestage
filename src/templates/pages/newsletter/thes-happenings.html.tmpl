<!--
  THUNDER HILL PTA — THES OFFICIAL NEWSLETTER / THES HAPPENINGS
  (generated by build.py — do not hand-edit pages/newsletter/thes-happenings.html)
  The embedded newsletter itself is a Smore page (config/site.json ->
  newsletter_href / newsletter_embed_src) — edit the actual newsletter
  content in Smore, and update those two fields here when there's a new
  issue link, not this file.
-->
{{TOKENS}}

<div class="thes">

  <div class="thes__pagehead">
    <div class="thes__pagehead-text">
      <span class="thes__eyebrow">Newsletters</span>
      <h1>{{PAGE_TITLE}}</h1>
      <p>Everything happening at {{school_name}} and around the PTA, straight from our Smore newsletter.</p>
    </div>
    <div class="thes__pagehead-media">
      <img src="{{PAGE_HEADER_IMAGE_URL}}" alt="{{school_name}}">
    </div>
  </div>

  <!-- ===== Newsletter embed ===== -->
  <section class="thes__section">
    <div class="thes__wrap">
      <iframe
        width="100%"
        height="1400"
        src="{{newsletter_embed_src}}"
        title="THES Happenings — {{org_name}} Newsletter"
        scrolling="auto"
        frameborder="0"
        allowtransparency="true"
        style="min-width:320px;border:none;display:block;"
      ></iframe>
      <p style="margin-top:16px; text-align:center;">
        <a class="thes__btn thes__btn--navy" href="{{newsletter_href}}" target="_blank" rel="noopener">Subscribe for Future Issues &rarr;</a>
      </p>
    </div>
  </section>

{{FOOTER}}

</div>
