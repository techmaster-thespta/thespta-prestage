<!--
  THUNDER HILL PTA — VENDOR MAP PAGE (generated by build.py — do not hand-edit)
  events/<slug>/vendor-map.html, one per featured event page with
  `vendor_map` set. Its own page so the PTA can share one link / QR code
  that opens straight to the map. Data: config/vendor-maps/<file>.json.
-->
{{TOKENS}}

<div class="thes">

  <div class="thes__pagehead thes__pagehead--compact">
    <div class="thes__pagehead-text">
      {{VMAP_BREADCRUMB}}
      <span class="thes__eyebrow">{{VMAP_EYEBROW}}</span>
      <h1>{{VMAP_PAGE_TITLE}}</h1>
      <p>{{VMAP_TAGLINE}}</p>
    </div>
  </div>

{{VMAP_SECTION}}

  <section class="thes__section thes__section--tint">
    <div class="thes__wrap" style="text-align:center;">
      <a class="thes__btn thes__btn--teal" href="{{VMAP_EVENT_HREF}}">&larr; Back to {{VMAP_EVENT_NAME}} details</a>
    </div>
  </section>

{{FOOTER}}

</div>
