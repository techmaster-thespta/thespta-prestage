  <section class="thes__section" id="vendor-map">
    <div class="thes__wrap">
      <div class="thes__section-head">
        <p>{{VMAP_NOTE}}</p>
      </div>
      <div class="thes__vmap-tools">
        <input type="search" class="thes__vmap-search" id="thes-vmap-search" placeholder="Search vendors, e.g. candles, cookies, 23" aria-label="Search vendors">
        <div class="thes__vmap-chips" role="group" aria-label="Filter vendors">
          {{VMAP_CHIPS}}
        </div>
      </div>
      <div class="thes__vmap-frame">
        <div class="thes__vmap" style="grid-template-columns:repeat({{VMAP_COLS}}, minmax(0, 1fr));grid-template-rows:repeat({{VMAP_ROWS}}, auto);">
        {{VMAP_CELLS}}
        </div>
        {{VMAP_HALL}}
      </div>
      <div class="thes__vmap-detail" id="thes-vmap-detail" aria-live="polite">Tap a numbered booth to see who's there.</div>
      <div class="thes__vmap-legend">
        <span><b class="thes__vmap-key"></b>Vendor</span>
        <span><b class="thes__vmap-key thes__vmap-key--food"></b>Food</span>
        <span><b class="thes__vmap-key thes__vmap-key--children"></b>Children's</span>
        <span><b class="thes__vmap-key thes__vmap-key--hall"></b>Hallway table</span>
        <span><b class="thes__vmap-key thes__vmap-key--plug"></b>Has outlet</span>
      </div>
      <div class="thes__vmap-groups" id="thes-vmap-groups">
{{VMAP_LISTS}}
      </div>
      <p class="thes__vmap-empty" id="thes-vmap-empty" hidden>No vendors match that search.</p>
    </div>
  </section>
<script>
(function () {
  var root = document.getElementById("vendor-map");
  if (!root) return;
  var PER_PAGE = {{VMAP_PER_PAGE}};
  var booths = root.querySelectorAll(".thes__vmap-booth");
  var items = root.querySelectorAll(".thes__vmap-item");
  var paged = root.querySelectorAll(".thes__vmap-group[data-paged] .thes__vmap-item");
  var detail = document.getElementById("thes-vmap-detail");
  var search = document.getElementById("thes-vmap-search");
  var empty = document.getElementById("thes-vmap-empty");
  var chips = root.querySelectorAll(".thes__vmap-chip[data-filter]");
  var pager = document.getElementById("thes-vmap-pager");
  var label = document.getElementById("thes-vmap-page");
  var prev = document.getElementById("thes-vmap-prev");
  var next = document.getElementById("thes-vmap-next");
  var filter = "", page = 0, hits = [];

  function matches(it, q) {
    if (q && it.getAttribute("data-search").indexOf(q) === -1) return false;
    if (!filter) return true;
    var tags = " " + it.getAttribute("data-tags") + " ";
    return filter.split(" ").some(function (f) { return tags.indexOf(" " + f + " ") !== -1; });
  }

  function apply() {
    var q = (search.value || "").trim().toLowerCase();
    var shown = 0, matched = {};
    hits = [];
    for (var i = 0; i < items.length; i++) {
      var it = items[i], ok = matches(it, q);
      it.hidden = !ok;
      if (ok) { shown++; if (it.getAttribute("data-booth")) matched[it.getAttribute("data-booth")] = true; }
    }
    // Page the gym list through whatever is left after the filter; a
    // search shows every match at once.
    for (var p = 0; p < paged.length; p++) if (!paged[p].hidden) hits.push(paged[p]);
    var pages = q ? 1 : Math.max(1, Math.ceil(hits.length / PER_PAGE));
    if (page >= pages) page = pages - 1;
    if (!q) for (var h = 0; h < hits.length; h++) hits[h].hidden = Math.floor(h / PER_PAGE) !== page;
    pager.hidden = pages < 2;
    label.textContent = "Page " + (page + 1) + " of " + pages;
    prev.disabled = page === 0;
    next.disabled = page === pages - 1;
    var active = q || filter;
    for (var k = 0; k < booths.length; k++) {
      var on = matched[booths[k].getAttribute("data-booth")];
      booths[k].classList.toggle("is-dim", !!active && !on);
      booths[k].classList.toggle("is-match", !!active && !!on);
    }
    var groups = root.querySelectorAll(".thes__vmap-group");
    for (var g = 0; g < groups.length; g++) groups[g].hidden = !groups[g].querySelector(".thes__vmap-item:not([hidden])");
    empty.hidden = shown !== 0;
  }

  function select(num, scrollToMap) {
    var li = root.querySelector('.thes__vmap-item[data-booth="' + num + '"]');
    var b = root.querySelector('.thes__vmap-booth[data-booth="' + num + '"]');
    if (!b || !li) return;
    // Tapping a booth flips the gym list to the page that has it.
    var idx = hits.indexOf(li);
    if (idx !== -1 && li.hidden) { page = Math.floor(idx / PER_PAGE); apply(); }
    for (var i = 0; i < booths.length; i++) booths[i].classList.toggle("is-selected", booths[i] === b);
    for (var j = 0; j < items.length; j++) items[j].classList.toggle("is-selected", items[j] === li);
    var name = li.querySelector(".thes__vmap-name");
    var tags = li.querySelectorAll(".thes__vmap-tag");
    var more = li.querySelector(".thes__vmap-more");
    var html = '<span class="thes__vmap-num">' + num + '</span> <strong>' + name.innerHTML + '</strong> ';
    for (var t = 0; t < tags.length; t++) html += tags[t].outerHTML;
    if (more) html += '<div class="thes__vmap-more">' + more.innerHTML + '</div>';
    detail.innerHTML = html;
    detail.classList.add("is-on");
    if (scrollToMap) b.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  for (var i = 0; i < booths.length; i++) {
    booths[i].addEventListener("click", function () { select(this.getAttribute("data-booth"), false); });
  }
  for (var j = 0; j < items.length; j++) {
    if (!items[j].getAttribute("data-booth")) continue;
    items[j].setAttribute("tabindex", "0");
    items[j].addEventListener("click", function () { select(this.getAttribute("data-booth"), true); });
    items[j].addEventListener("keydown", function (e) { if (e.key === "Enter") select(this.getAttribute("data-booth"), true); });
  }
  search.addEventListener("input", function () { page = 0; apply(); });
  prev.addEventListener("click", function () { page--; apply(); });
  next.addEventListener("click", function () { page++; apply(); });
  for (var c = 0; c < chips.length; c++) {
    chips[c].addEventListener("click", function () {
      for (var x = 0; x < chips.length; x++) chips[x].classList.remove("is-on");
      this.classList.add("is-on");
      filter = this.getAttribute("data-filter");
      page = 0; apply();
    });
  }
  apply();
})();
</script>
